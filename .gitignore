# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

# Virtual Environments
.env
.venv/
env/
venv/
ENV/

# Streamlit configurations (track config.toml, ignore credentials/secrets)
.streamlit/*
!.streamlit/config.toml

# Processed data cache (regenerable via python src/train_all.py)
data/processed/*
!data/processed/.gitkeep

# Jupyter Notebook checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# System & OS artifacts
.DS_Store
Thumbs.db
desktop.ini
*.log
*.tmp
*.bak
